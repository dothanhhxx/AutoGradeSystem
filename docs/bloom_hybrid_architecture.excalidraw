    {
      "type": "text", "id": "p2_weights_t",
      "x": 478, "y": 275, "width": 434, "height": 64,
      "text": "Bloom-Conditioned Weight Controller w(b) [CORE NOVELTY]\n• Remember (b=1): w = [sem:.20, cov:.45, gra:.10, for:.05, log:.20]\n• Analyze  (b=4): w = [sem:.20, cov:.25, gra:.05, for:.05, log:.45]",
      "originalText": "Bloom-Conditioned Weight Controller w(b) [CORE NOVELTY]\n• Remember (b=1): w = [sem:.20, cov:.45, gra:.10, for:.05, log:.20]\n• Analyze  (b=4): w = [sem:.20, cov:.25, gra:.05, for:.05, log:.45]",
      "fontSize": 13, "fontFamily": 3, "textAlign": "left", "verticalAlign": "middle",
      "strokeColor": "#374151", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
